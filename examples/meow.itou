// 貓貓語言示範：中文關鍵字、中文型別，以及「喵」家族的內建操作。
令 問候 = "你好，itouLang！";
喵(問候);
喵("6 × 7 =", 6 * 7);

函式 費式(第幾項: 數字): 數字 {
  若 (第幾項 < 2) { 回傳 第幾項; }
  回傳 費式(第幾項 - 1) + 費式(第幾項 - 2);
}
喵("費波那契：", 費式(10));

令 i = 0;
當 (i < 5) {
  i = i + 1;
  若 (i % 2 == 0) { 繼續; }
  喵("奇數", i);
}

// 喵家族：喵喵 會加上喵前綴，喵長／喵型／喵字／喵數／喵根／喵驗 對應原本的內建。
喵喵("喵喵會在輸出前面加上喵～");
喵("問候長度：", 喵長(問候));
喵("問候型別：", 喵型(問候));
喵("喵重複：", 喵重複("喵", 5));
喵("喵黏：", 喵黏("抓", "到", "魚", "了"));
喵("今天是", 喵選(費式(10) > 50, "大魚日", "小魚日"));
喵("喵叫：", 喵叫());
