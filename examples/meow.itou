// 貓貓語言示範：中文關鍵字、中文型別，以及「喵」家族的內建操作。
字串 問候 = "你好，itouLang！";
喵out << 問候 << 喵endl;
喵out << "6 × 7 = " << 6 * 7 << 喵endl;

數字 費式(數字 第幾項) {
  若 (第幾項 < 2) { 回傳 第幾項; }
  回傳 費式(第幾項 - 1) + 費式(第幾項 - 2);
}
喵out << "費波那契： " << 費式(10) << 喵endl;

整數 索引 = 0;
當 (索引 < 5) {
  ++索引;
  若 (索引 % 2 == 0) { 繼續; }
  喵out << "奇數 " << 索引 << 喵endl;
}

// 喵家族：喵喵 會加上喵前綴，喵長／喵型／喵字／喵數／喵根／喵驗 對應原本的內建。
喵喵("喵喵會在輸出前面加上喵～");
喵out << "問候長度： " << 喵長(問候) << 喵endl;
喵out << "問候型別： " << 喵型(問候) << 喵endl;
喵out << "喵重複： " << 喵重複("喵", 5) << 喵endl;
喵out << "喵黏： " << 喵黏("抓", "到", "魚", "了") << 喵endl;
喵out << "今天是 " << 喵選(費式(10) > 50, "大魚日", "小魚日") << 喵endl;
喵out << "喵叫： " << 喵叫() << 喵endl;
